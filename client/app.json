{
  "expo": {
    "name": "client",
    "slug": "client",
    "version": "1.0.0",

    "web": {
      "favicon": "./src/assets/favicon.png"
    },

    "experiments": {
      "tsconfigPaths": true
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ]
    ],

    "orientation": "portrait",
    "icon": "./src/assets/icon.png",

    "userInterfaceStyle": "light",

    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
