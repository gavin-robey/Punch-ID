# Copy to server/.env and fill in the values.
# When running with docker compose, PORT and URI are overridden by docker-compose.yml.

PORT="3000"
# local MongoDB when running the server outside docker
URI="mongodb://localhost:27017/punch-id"
# used to build verification / password reset links (PORT is appended)
BASE_URL="http://localhost:"

# origins allowed to call the API from a browser (the Expo web app), comma-separated
CORS_URL="http://localhost:8081"

# signs access and refresh tokens, use any long random string
JWT_SECRET="change-me"

# https://mailtrap.io - sends verification and password reset emails
MAILTRAP_TOKEN=""

# https://cloudinary.com - stores avatars, punch item media and attachments
CLOUD_NAME=""
CLOUD_KEY=""
CLOUD_SECRET=""
