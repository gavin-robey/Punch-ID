# Copy to .env (next to docker-compose.yml) to override the defaults below.

# Where the app sends API requests. localhost works for the web app in your browser.
# For Expo Go on a phone use your computer's LAN IP, e.g. http://192.168.1.20:3000/
EXPO_PUBLIC_API_URL=http://localhost:3000/

# Host Expo Go should load the bundle from. Set to your computer's LAN IP for a physical phone.
REACT_NATIVE_PACKAGER_HOSTNAME=localhost

# Host port for MongoDB (27018 avoids clashing with a MongoDB already running locally on 27017)
MONGO_HOST_PORT=27018
